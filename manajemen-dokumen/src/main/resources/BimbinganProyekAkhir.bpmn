  <bpmn:collaboration id="Collaboration_0f7xsqe">
    <bpmn:participant id="Participant_0seofjr" name="Bimbingan TA / PA" processRef="BimbinganProyekAkhir" />
  </bpmn:collaboration>
  <bpmn:process id="BimbinganProyekAkhir" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_0w1ulmq</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0w1ulmq" sourceRef="StartEvent_1" targetRef="submitLaporan" />
    <bpmn:userTask id="submitLaporan" name="Submit Laporan ">
      <bpmn:incoming>Flow_0w1ulmq</bpmn:incoming>
      <bpmn:outgoing>Flow_0ky3zdl</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0ky3zdl" sourceRef="submitLaporan" targetRef="reviewPembimbing" />
    <bpmn:userTask id="reviewPembimbing" name="Review Pembimbing" camunda:assignee="${reviewer}">
      <bpmn:incoming>Flow_0ky3zdl</bpmn:incoming>
      <bpmn:incoming>Flow_13n9sen</bpmn:incoming>
      <bpmn:outgoing>Flow_12gllpt</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics camunda:collection="reviewers" camunda:elementVariable="reviewer">
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">${decision == 'ditolak'}</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_0e2vu1w">
      <bpmn:incoming>Flow_12gllpt</bpmn:incoming>
      <bpmn:outgoing>Flow_0bfnuwk</bpmn:outgoing>
      <bpmn:outgoing>Flow_0dcqokm</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_12gllpt" sourceRef="reviewPembimbing" targetRef="Gateway_0e2vu1w" />
    <bpmn:endEvent id="Event_1tryius" name="End">
      <bpmn:incoming>Flow_0bfnuwk</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0bfnuwk" name="Diterima" sourceRef="Gateway_0e2vu1w" targetRef="Event_1tryius">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == 'diterima'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0dcqokm" name="Revisi" sourceRef="Gateway_0e2vu1w" targetRef="revisiLaporan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == 'ditolak'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="revisiLaporan" name="Revisi Laporan" camunda:assignee="${requestor}">
      <bpmn:incoming>Flow_0dcqokm</bpmn:incoming>
      <bpmn:outgoing>Flow_13n9sen</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_13n9sen" sourceRef="revisiLaporan" targetRef="reviewPembimbing" />
  </bpmn:process>
