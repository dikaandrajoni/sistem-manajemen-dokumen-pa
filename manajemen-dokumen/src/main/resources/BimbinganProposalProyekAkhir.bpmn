    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_12t8qlr" name="End">
      <bpmn:incoming>Flow_0qjaenu</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="revisiProposal" name="Revisi Proposal" camunda:assignee="${requestor}">
      <bpmn:incoming>Flow_0hd5lc7</bpmn:incoming>
      <bpmn:outgoing>Flow_1dfdv5g</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1dfdv5g" sourceRef="revisiProposal" targetRef="reviewProposal" />
    <bpmn:sequenceFlow id="Flow_0hd5lc7" name="Revisi" sourceRef="Gateway_0cp6ezf" targetRef="revisiProposal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == 'ditolak'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0qjaenu" name="Diterima" sourceRef="Gateway_0cp6ezf" targetRef="Event_12t8qlr">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == 'diterima'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1xiyzwl" sourceRef="reviewProposal" targetRef="Gateway_0cp6ezf" />
    <bpmn:sequenceFlow id="Flow_0e6ad8m" sourceRef="submitProposal" targetRef="reviewProposal" />
    <bpmn:sequenceFlow id="Flow_0ov7bbu" sourceRef="Event_0rm0e6j" targetRef="submitProposal" />
  </bpmn:process>
