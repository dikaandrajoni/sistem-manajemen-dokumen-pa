  <bpmn:collaboration id="Collaboration_0zbgkmi">
    <bpmn:participant id="Participant_1mxysau" name="Bimbingan Proposal Proyek Akhir" processRef="BimbinganProposalProyekAkhir" />
  </bpmn:collaboration>
  <bpmn:process id="BimbinganProposalProyekAkhir" isExecutable="true">
    <bpmn:startEvent id="Event_0rm0e6j" name="Start">
      <bpmn:outgoing>Flow_0ov7bbu</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="submitProposal" name="Submit Proposal">
      <bpmn:incoming>Flow_0ov7bbu</bpmn:incoming>
      <bpmn:outgoing>Flow_0e6ad8m</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="reviewProposal" name="Review Pembimbing" camunda:assignee="${reviewer}">
      <bpmn:incoming>Flow_1dfdv5g</bpmn:incoming>
      <bpmn:incoming>Flow_0e6ad8m</bpmn:incoming>
      <bpmn:outgoing>Flow_1xiyzwl</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics camunda:collection="reviewers" camunda:elementVariable="reviewer">
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">${decision == 'ditolak'}</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_0cp6ezf">
      <bpmn:incoming>Flow_1xiyzwl</bpmn:incoming>
